{
    "name": "fpjd/sso",
    "description": "SDK y cliente de integración oficial para el SSO Accounts de la Fundación Parque Jaime Duque",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Fundación Parque Jaime Duque",
            "email": "soporte@parquejaimeduque.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.10",
        "psr/http-message": "^1.0 || ^2.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Fpjd\\Sso\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fpjd\\Sso\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
